# Development mode accepts tokens in the form demo:<tenant-id>:<role>.
# Production mode disables demo tokens and requires API key mappings injected
# through the deployment environment. Do not commit real credentials.
HERITAGEFLOW_ENV=development
HERITAGEFLOW_STORAGE=sqlite
HERITAGEFLOW_DB_PATH=./heritageflow.db
HERITAGEFLOW_VISITOR_HASH_KEY=replace-through-local-environment
# HERITAGEFLOW_API_KEYS_JSON={"opaque-runtime-token":{"tenant_id":"guanlin","role":"tenant_admin"}}
# HERITAGEFLOW_DYNAMODB_TABLE=heritageflow
# HERITAGEFLOW_AWS_REGION=eu-west-1
# Docker Compose exposes DynamoDB Local on host port 8001.
# HERITAGEFLOW_DYNAMODB_ENDPOINT_URL=http://localhost:8001
# HERITAGEFLOW_SEED_DEMO=false

