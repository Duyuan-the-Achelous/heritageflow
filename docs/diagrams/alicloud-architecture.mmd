    RDS[("ApsaraDB RDS MySQL\nmanaged persistent data")]
    SECRETS["Runtime secrets\nRAM and encrypted variables"]
    OBS["SLS and CloudMonitor\nlogs, metrics, alerts"]
  end

  subgraph Preview["Current preview and fallback"]
    SAS["Lightweight Application Server\nNginx and Docker v3"]
    SQLITE[("Persistent SQLite volume")]
  end

  GH -->|push image| ACR
  ACR -->|deploy immutable revision| SAE
  U -->|HTTPS| ENTRY
  ENTRY --> SAE
  SAE -->|tenant-scoped SQL transactions| RDS
  SECRETS --> SAE
  SAE --> OBS
  ENTRY --> OBS
  U -. assessment fallback .-> SAS
  SAS --> SQLITE

