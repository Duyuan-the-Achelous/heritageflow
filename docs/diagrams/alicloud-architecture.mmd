flowchart LR
  U["Visitors, tenant admins, validators"]

  subgraph Delivery["Delivery pipeline"]
    GH["GitHub Actions\nbuild, test, deploy"]
    ACR["Alibaba Cloud Container Registry\nversioned images"]
  end

  subgraph Alibaba["Alibaba Cloud target environment"]
    ENTRY["HTTPS public endpoint\nmanaged ingress or load balancer"]
